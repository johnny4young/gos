{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/johnny4young/gos/main/docs/schema/env.schema.json",
  "title": "gos env --json",
  "description": "PATH setup values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "install_dir": {
      "type": "string",
      "description": "GOS_INSTALL_DIR."
    },
    "bin_dir": {
      "type": "string",
      "description": "Directory to put on PATH."
    },
    "auto": {
      "type": "boolean",
      "description": "True when --auto was requested (the hook is printed in text mode only)."
    }
  },
  "required": [
    "install_dir",
    "bin_dir",
    "auto"
  ]
}
