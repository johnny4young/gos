{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/johnny4young/gos/main/docs/schema/env-reference.schema.json",
  "title": "gos __env --json",
  "description": "The environment variable manifest that generates the README table and the man page.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "variables": {
      "type": "array",
      "description": "Variables in manifest order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "readers",
          "default",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Variable name.",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "readers": {
            "type": "array",
            "description": "Scripts that read it.",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "string",
            "description": "Default value as documented."
          },
          "description": {
            "type": "string",
            "description": "What it does."
          }
        }
      }
    }
  },
  "required": [
    "variables"
  ]
}
