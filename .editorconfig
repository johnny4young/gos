# shfmt reads these keys, so `shfmt -d .` matches CI (-i 2 -ci -bn) without flags.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
